{
  "name": "rolecraft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -b",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:docs": "node --test \"scripts/docs/*.test.mjs\"",
    "verify:docs": "node scripts/docs/cli.mjs verify",
    "task:index": "node scripts/docs/cli.mjs index",
    "task:close": "node scripts/docs/cli.mjs close",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:docs && npm run verify:docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.13.0",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
